# Copy to backend/.env for local development. Never commit real values.
DEBUG=True
DJANGO_SECRET_KEY=replace-with-a-random-local-secret
DATABASE_URL=postgres://rental:rental@localhost:5432/rental_marketplace
REDIS_URL=redis://localhost:6379/0
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Public origin of the Next.js site (used in email links).
FRONTEND_BASE_URL=http://localhost:3000
# Number of trusted reverse proxies in front of Django (1 behind nginx/Caddy). 0 when exposed directly.
NUM_PROXIES=0

# --- SMS / OTP (Africa's Talking). Blank in development: OTPs print to the Django console.
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=

# --- Payments. "simulator" works locally without credentials (DEBUG only; refused in production).
#     Complete a simulated payment with: python manage.py simulate_payment
PAYMENT_PROVIDER=simulator
DEFAULT_COUNTRY=KE
PAYMENT_QUERY_AFTER_SECONDS=90
PAYMENT_TIMEOUT_MINUTES=10

# --- M-Pesa Daraja (required when PAYMENT_PROVIDER=mpesa). See docs/PAYMENTS.md.
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
# CustomerPayBillOnline (paybill) or CustomerBuyGoodsOnline (till; then set MPESA_PARTY_B to the till number)
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
MPESA_PARTY_B=
MPESA_CALLBACK_URL=https://your-public-domain.example/api/v1/payments/mpesa/callback
# At least 32 random characters, e.g. python -c "import secrets; print(secrets.token_urlsafe(32))"
MPESA_CALLBACK_TOKEN=replace-with-a-long-random-secret-of-32-plus-characters
MPESA_CONFIRM_CALLBACKS=True
# Optional comma-separated IPs/CIDRs allowed to post callbacks.
MPESA_CALLBACK_ALLOWED_IPS=

# --- Referrals and listings
REFERRAL_ATTRIBUTION_DAYS=60
REFERRAL_FEE_DUE_DAYS=7
LISTINGS_REQUIRE_APPROVAL=False
AVAILABILITY_CONFIRMATION_DAYS=30

# --- Listing photos (Cloudflare R2, public bucket)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT_URL=
R2_PUBLIC_BASE_URL=

# --- Landlord verification documents (PRIVATE bucket; never the public photo bucket).
#     Leave blank in development to store them under backend/private_media/ (git-ignored, never served).
R2_PRIVATE_BUCKET_NAME=
VERIFICATION_DOCUMENT_RETENTION_DAYS=90

# --- Optional email notifications (enabled when EMAIL_HOST is set)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Nyumbani <no-reply@example.com>

SENTRY_DSN=
