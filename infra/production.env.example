# Copy to infra/production.env on the server (chmod 600). Never commit the real file.
# ---- Public site
SITE_ADDRESS=nyumbani.example.co.ke
PUBLIC_ORIGIN=https://nyumbani.example.co.ke
DJANGO_ADMIN_PATH=staff-7f3k2

# ---- Django
DJANGO_SECRET_KEY=generate-with: python -c "import secrets; print(secrets.token_urlsafe(50))"
ALLOWED_HOSTS=nyumbani.example.co.ke,backend
CSRF_TRUSTED_ORIGINS=https://nyumbani.example.co.ke
CORS_ALLOWED_ORIGINS=https://nyumbani.example.co.ke
FRONTEND_BASE_URL=https://nyumbani.example.co.ke
ADMIN_URL=staff-7f3k2/
NUM_PROXIES=1
# Caddy terminates TLS and redirects HTTP to HTTPS; Django is reachable only inside the Docker network.
SECURE_SSL_REDIRECT=False
WEB_CONCURRENCY=3
INTERNAL_API_TOKEN=generate-a-long-random-value
LEGAL_POLICY_VERSION=draft-1

# ---- Database / cache (the compose file's own services)
POSTGRES_PASSWORD=generate-a-long-random-value
DATABASE_URL=postgres://rental:SAME_AS_POSTGRES_PASSWORD@db:5432/rental_marketplace
REDIS_URL=redis://redis:6379/0

# ---- SMS (Africa's Talking) - required
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=

# ---- Payments (Safaricom Daraja). See docs/PAYMENTS.md
PAYMENT_PROVIDER=mpesa
MPESA_ENV=production
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
MPESA_PARTY_B=
MPESA_CALLBACK_URL=https://nyumbani.example.co.ke/api/v1/payments/mpesa/callback
MPESA_CALLBACK_TOKEN=generate-at-least-32-random-characters
MPESA_CONFIRM_CALLBACKS=True
MPESA_CALLBACK_ALLOWED_IPS=

# ---- Storage (Cloudflare R2): public bucket for listing photos, PRIVATE bucket for verification documents
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PRIVATE_BUCKET_NAME=
R2_ENDPOINT_URL=
R2_PUBLIC_BASE_URL=
VERIFICATION_DOCUMENT_RETENTION_DAYS=90

# ---- Optional email
EMAIL_HOST=
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Nyumbani <no-reply@nyumbani.example.co.ke>

# ---- Business rules
DEFAULT_COUNTRY=KE
REFERRAL_ATTRIBUTION_DAYS=60
REFERRAL_FEE_DUE_DAYS=7
LISTINGS_REQUIRE_APPROVAL=False
